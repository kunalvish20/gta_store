    {"source": "/payment", "destination": "/_seo/payment.html"},
    {"source": "/order-status", "destination": "/_seo/order-status.html"},
    {"source": "/warranty", "destination": "/_seo/warranty.html"},
    {"source": "/cart", "destination": "/_seo/cart.html"},
    {"source": "/checkout", "destination": "/_seo/checkout.html"},
